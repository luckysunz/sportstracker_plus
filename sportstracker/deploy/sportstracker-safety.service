[Unit]
Description=Sportstracker safety service (powers the Pi off when the CPU gets too hot)
After=multi-user.target

[Service]
Type=simple
User=root
WorkingDirectory=@DIR@
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=@VENV@/bin/python -m sportstracker.service_safety --config @DIR@/config/config.json
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
