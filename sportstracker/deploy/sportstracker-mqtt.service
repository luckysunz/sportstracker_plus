[Unit]
Description=Sportstracker+ MQTT service (satellite sensors)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=@USER@
WorkingDirectory=@DIR@
Environment=PYTHONUNBUFFERED=1
ExecStart=@VENV@/bin/python -m sportstracker.service_mqtt --config @DIR@/config/config.json
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
